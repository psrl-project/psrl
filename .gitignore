# =========================================================================
# Project-specific (PSRL)
# =========================================================================
examples/visualization/.*/
unit_tests/nixl/plot/
third_party/
third_party_old/
third_party_old_2/
third_party_new/

# Auto-generated Sphinx api docs
/docs/generated

# Misc project data
dataset/*
tensorflow/my_graph/*


# =========================================================================
# Runtime artifacts / outputs (apply anywhere in the repo)
# =========================================================================
# Common artifact file types
**/*.log
**/*.pdf
**/*.pkl
**/*.png
**/*.pt
**/*.ckpt
**/*.tar.gz
**/*.jsonl
**/*.parquet
**/*.lock

# Documentation figures are source assets, not runtime artifacts, so they are
# re-included after the broad file-type rules above.
!docs/_static/img/*.png
!assets/*.png

# AIRS-Bench pinned parquet dataset files (small metadata, not training data).
!examples/airs_bench/data/
!examples/airs_bench/data/*.parquet

# Common artifact directories
**/checkpoints
**/ckpts
**/wget-log
**/_build/
**/outputs
**/outputs/

# Talk material. Cites cluster-side measurements that stay out of published docs.
examples/sciaccel_rl/slides/
**/output/
**/playground
**/wandb
**/logs/
**/log/
**/*log*/
!examples/mini_swe/grading/_vendor/log_parsers/
# "topology" contains "log", so the rule above swallows this config group.
!psrl/eval/config/topology/
**/models/
**/data/
**/results/


# =========================================================================
# Python: byte-compiled / optimized / DLL files
# =========================================================================
__pycache__/
*.py[cod]
*$py.class
*.so


