+def _global_bundle_index_to_pg_local_rank(pgs: list[PlacementGroup], bundle_index: int) -> tuple[int, int]:
+    """Map a pool-global bundle index to (placement group index, PG-local bundle index)."""
+    if bundle_index < 0:
+        raise IndexError(f"bundle_index must be >= 0, got {bundle_index}")
+    offset = 0
+    for pg_idx, pg in enumerate(pgs):
+        next_offset = offset + pg.bundle_count
+        if bundle_index < next_offset:
+            return pg_idx, bundle_index - offset
+        offset = next_offset
+    raise IndexError(
+        f"bundle_index={bundle_index} is out of range for {len(pgs)} placement groups "
+        f"with total bundle_count={offset}"
+    )
+
