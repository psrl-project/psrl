 impl ProtoGenerateRequest {
+    /// Return the resolved generation budget before loopback adjustment.
+    pub(crate) fn max_new_tokens(&self) -> Option<u32> {
+        match self {
+            Self::Sglang(req) => req.sampling_params.as_ref()?.max_new_tokens,
+            Self::Vllm(req) => req.sampling_params.as_ref()?.max_tokens,
+            Self::Trtllm(req) => Some(req.max_tokens),
+            Self::Mlx(req) => req.sampling_params.as_ref()?.max_tokens,
+            Self::TokenSpeed(req) => req.sampling_params.as_ref()?.max_new_tokens,
+        }
+    }
+
+    /// Extend the tokenized prompt and consume the accumulated generation budget.
+    pub(crate) fn continue_from_tokens(&mut self, tokens: &[u32]) -> Result<(), &'static str> {
+        if tokens.is_empty() {
+            return Ok(());
+        }
+        let consumed = u32::try_from(tokens.len()).map_err(|_| "Completion prefix is too long.")?;
+        match self {
+            Self::Sglang(req) => {
+                req.tokenized
+                    .as_mut()
+                    .ok_or("Tokenized input is missing.")?
+                    .input_ids
+                    .extend_from_slice(tokens);
+                if let Some(params) = req.sampling_params.as_mut() {
+                    params.max_new_tokens =
+                        params.max_new_tokens.map(|v| v.saturating_sub(consumed));
+                    params.min_new_tokens = params.min_new_tokens.saturating_sub(consumed);
+                }
+            }
+            Self::Vllm(req) => {
+                let Some(vllm::generate_request::Input::Tokenized(input)) = req.input.as_mut()
+                else {
+                    return Err("Tokenized input is missing.");
+                };
+                input.input_ids.extend_from_slice(tokens);
+                if let Some(params) = req.sampling_params.as_mut() {
+                    params.max_tokens = params.max_tokens.map(|v| v.saturating_sub(consumed));
+                    params.min_tokens = params.min_tokens.saturating_sub(consumed);
+                }
+            }
+            Self::Trtllm(req) => {
+                req.tokenized
+                    .as_mut()
+                    .ok_or("Tokenized input is missing.")?
+                    .input_token_ids
+                    .extend_from_slice(tokens);
+                req.max_tokens = req.max_tokens.saturating_sub(consumed);
+                if let Some(params) = req.sampling_config.as_mut() {
+                    params.min_tokens = params.min_tokens.map(|v| v.saturating_sub(consumed));
+                }
+            }
+            Self::Mlx(req) => {
+                let Some(mlx::generate_request::Input::Tokenized(input)) = req.input.as_mut()
+                else {
+                    return Err("Tokenized input is missing.");
+                };
+                input.input_ids.extend_from_slice(tokens);
+                if let Some(params) = req.sampling_params.as_mut() {
+                    params.max_tokens = params.max_tokens.map(|v| v.saturating_sub(consumed));
+                }
+            }
+            Self::TokenSpeed(req) => {
+                req.tokenized
+                    .as_mut()
+                    .ok_or("Tokenized input is missing.")?
+                    .input_ids
+                    .extend_from_slice(tokens);
+                if let Some(params) = req.sampling_params.as_mut() {
+                    params.max_new_tokens =
+                        params.max_new_tokens.map(|v| v.saturating_sub(consumed));
+                    params.min_new_tokens = params.min_new_tokens.saturating_sub(consumed);
+                }
+            }
+        }
+        Ok(())
+    }
