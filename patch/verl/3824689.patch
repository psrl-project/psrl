+# ---------------------------------------------------------------------------
+# NCCL no-fork patch for DCP async save
+#
+# DCP's FileSystemWriterAsync.write_preloaded_data_multiproc forks child
+# processes via mp.get_context("fork"). Forked children inherit NCCL
+# communicators; when the child exits, ncclCommAbort runs and corrupts the
+# parent's NCCL state, eventually causing a 600-second timeout and SIGABRT.
+#
+# The fix: replace the multiproc entry-point with a sequential in-process
+# version that uses stdlib queue.SimpleQueue instead of forking.
+# ---------------------------------------------------------------------------
+from megatron.core.dist_checkpointing.strategies import filesystem_async as _fsa
+
+_orig_write_preloaded_data = _fsa.FileSystemWriterAsync.write_preloaded_data
+
+
+def _write_preloaded_data_multiproc_nofork(transform_list, use_msc, rank, write_buckets, global_results_queue):
+    """Sequential no-fork replacement for FileSystemWriterAsync.write_preloaded_data_multiproc.
+
+    Processes write buckets one at a time in the current process to avoid
+    forking NCCL communicators which causes ncclCommAbort corruption.
+    """
+    write_results = {}
+    for i, write_bucket in enumerate(write_buckets):
+        results_q = _stdlib_queue.SimpleQueue()
+        count_q = _stdlib_queue.Queue()
+        count_q.put(i)
+        kwargs = {
+            "local_proc_idx": i,
+            "write_bucket": write_bucket,
+            "results_queue": results_q,
+            "count_queue": count_q,
+            "use_fsync": True,
+        }
+        if use_msc:
+            kwargs["use_msc"] = use_msc
+        _orig_write_preloaded_data(transform_list, **kwargs)
+        local_proc_idx, local_results_or_exc = results_q.get()
+        if isinstance(local_results_or_exc, Exception):
+            raise local_results_or_exc
+        write_results[local_proc_idx] = local_results_or_exc
+    global_results_queue.put(write_results)
+
+
+_fsa.FileSystemWriterAsync.write_preloaded_data_multiproc = staticmethod(_write_preloaded_data_multiproc_nofork)
