+                    s: [i for i, sh in enumerate(shapes) if sh == s]
+                    for s in unique_shapes
+                }
+                first_mismatch_idx = next(
+                    (i for i, sh in enumerate(shapes) if sh != shapes[0]),
+                    None,
+                )
+                raise ValueError(
+                    f"Failed to concatenate non_tensor_batch key {key!r}: {e}. "
+                    f"Unique shapes and their indices: {problematic_indices}. "
+                    f"Sample value at index 0: {val[0]!r}, "
