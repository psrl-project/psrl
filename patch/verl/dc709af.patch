+"""The vocabulary-parallel head normalizer matches a full-vocabulary softmax."""
+
+import os
+import socket
+import tempfile
+
+import pytest
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+from verl.trainer.ppo.score_centering import topk_log_probs_from_logits
+
+
+def _free_port() -> int:
+    with socket.socket() as sock:
+        sock.bind(("127.0.0.1", 0))
+        return sock.getsockname()[1]
+
+
+def _rank_worker(rank: int, world: int, port: int, out_dir: str) -> None:
+    os.environ["MASTER_ADDR"] = "127.0.0.1"
+    os.environ["MASTER_PORT"] = str(port)
+    dist.init_process_group("gloo", rank=rank, world_size=world)
+    group = dist.group.WORLD
+    try:
+        torch.manual_seed(7)
+        rows, vocab, k = 6, 2 * 9, 4
+        full_logits = torch.randn(rows, vocab, dtype=torch.float64)
+        ids = torch.randint(0, vocab, (rows, k))
+        full = full_logits.clone().requires_grad_()
+        ref = torch.log_softmax(full.float(), dim=-1).gather(-1, ids)
+
+        local = vocab // world
+        shard = full_logits[:, rank * local : (rank + 1) * local].clone().to(torch.float32)
+        shard.requires_grad_()
+        out = topk_log_probs_from_logits(
+            shard,
+            ids,
+            chunk_elems=3 * local,
+            process_group=group,
+            vocab_size=vocab,
+        )
+        weight = torch.arange(out.numel(), dtype=out.dtype).view_as(out) + 1
+        (out * weight).sum().backward()
+
+        # The replicated loss must scale each rank's shard gradient exactly once.
+        ref_weighted = (ref * weight).sum()
+        ref_grad = torch.autograd.grad(ref_weighted, full, retain_graph=False)[0]
+        torch.testing.assert_close(out, ref, atol=1e-5, rtol=1e-5)
+        torch.testing.assert_close(
+            shard.grad,
+            ref_grad[:, rank * local : (rank + 1) * local].to(shard.dtype),
+            atol=1e-4,
+            rtol=1e-4,
+        )
+        if rank == 0:
+            with open(os.path.join(out_dir, "ok"), "w") as handle:
+                handle.write("1")
+    finally:
+        dist.destroy_process_group()
+
+
+@pytest.mark.cpu_test
+def test_vocab_parallel_head_log_probs_match_full_vocabulary():
+    out_dir = tempfile.mkdtemp(prefix="sc_vp_")
+    world, port = 2, _free_port()
+    mp.spawn(_rank_worker, args=(world, port, out_dir), nprocs=world, join=True)
+    assert os.path.exists(os.path.join(out_dir, "ok"))
