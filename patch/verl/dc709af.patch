+def _flatten_rows(tensor) -> torch.Tensor:
+    """Read a nested or dense per-row tensor as flat values without a Python row loop."""
+    if isinstance(tensor, torch.Tensor) and tensor.is_nested:
+        return tensor.values()
+    return torch.as_tensor(tensor)
