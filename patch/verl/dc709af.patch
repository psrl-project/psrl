+def _reconstruct_compact_field(lengths: torch.Tensor, flat: torch.Tensor, *, fill, dtype) -> torch.Tensor:
+    """Scatter flat per-row entries into a ``[rows, max_len]`` dense array.
+
+    ``lengths`` is one entry count per row; ``flat`` holds the concatenated entries. Unused columns
+    are filled with ``fill`` (the support sentinel). Rows are built with vectorized indexing, so the
+    row count, which can be tens of thousands, costs no Python loop.
+    """
+    rows = int(lengths.numel())
+    max_len = int(lengths.max().item()) if rows else 0
+    out = torch.full((rows, max_len), fill, dtype=dtype, device=flat.device)
+    if max_len == 0:
+        return out
+    total = int(lengths.sum().item())
+    if total:
+        row_idx = torch.repeat_interleave(torch.arange(rows, device=flat.device), lengths)
+        col_idx = torch.arange(total, device=flat.device) - torch.repeat_interleave(
+            torch.cumsum(lengths, 0) - lengths, lengths
+        )
+        out[row_idx, col_idx] = flat[:total].to(dtype)
