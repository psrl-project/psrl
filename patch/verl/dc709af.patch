+TOPK_LOG_PROB_CHUNK_ELEMS = 64 * 1024 * 1024
+"""fp32 workspace budget per chunk, in elements (64M elements is 256 MiB).
+
+The head-log-prob primitives keep an fp32 ``(rows, vocab)`` workspace; a fixed row count would scale
+that by the vocabulary (a 150k vocab makes 4096 rows ~2.5 GiB), so the budget is expressed in
+elements and the row count is derived from the local vocabulary size.
+"""
