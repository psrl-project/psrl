+HEAD_PADDING_ID = -1
+"""Sentinel token id for support slots outside a row's recorded support."""
+
+
+def _rows_per_chunk(chunk_elems: int, vocab_local: int, rows: int) -> int:
+    """Rows per chunk that keep the fp32 workspace near ``chunk_elems`` for this vocabulary shard."""
+    if chunk_elems <= 0:
+        return max(rows, 1)
+    return max(chunk_elems // max(vocab_local, 1), 1)
