+"""PSRL compact transport and shared sampled-token scoring for score centering."""
+
+import math
+
+import pytest
+import torch
+from tensordict import TensorDict
+from verl.trainer.ppo.score_centering import HEAD_PADDING_ID, score_centering_logits_processor
+from verl.trainer.config.algorithm import RolloutCorrectionConfig
+from verl.workers.config import ActorConfig, PolicyLossConfig
+
+
+def _actor_config(rollout_correction):
+    config = ActorConfig(
+        strategy="fsdp",
+        rollout_n=1,
+        ppo_micro_batch_size_per_gpu=1,
+        policy_loss=PolicyLossConfig(loss_mode="bypass_mode", rollout_correction=rollout_correction),
+        loss_agg_mode="token-mean",
+    )
+    config.global_batch_info.update(dp_size=1, batch_num_tokens=None, global_batch_size=None, loss_scale_factor=None)
+    return config
+
+
+def _topk_config():
+    return RolloutCorrectionConfig(
+        bypass_mode=True,
+        loss_type="reinforce",
+        rollout_is=None,
+        score_centering=True,
+    )
+
+
+def _support_config():
+    return RolloutCorrectionConfig(
+        bypass_mode=True,
+        loss_type="reinforce",
+        rollout_is=None,
+        score_centering=True,
+    )
+
+
+def _dense_topk(lengths, k, vocab, seed=0):
+    torch.manual_seed(seed)
+    rows = [torch.log_softmax(torch.randn(n, vocab) * 2, dim=-1) for n in lengths]
+    ids = [torch.randint(0, vocab, (n, k), dtype=torch.int32) for n in lengths]
+    log_probs = [row.gather(-1, i.long()) for row, i in zip(rows, ids, strict=True)]
+    return TensorDict(
+        {
+            "rollout_topk_ids": torch.nested.as_nested_tensor(ids, layout=torch.jagged),
+            "rollout_topk_log_probs": torch.nested.as_nested_tensor(log_probs, layout=torch.jagged),
+        },
+        batch_size=[len(lengths)],
+    )
+
+
+def _dense_support(lengths, k, vocab, seed=0):
+    torch.manual_seed(seed)
+    ids_rows, logp_rows, complete = [], [], []
+    for n in lengths:
+        row = torch.log_softmax(torch.randn(n, vocab) * 2, dim=-1)
+        # A nested support with a few finite entries per row, -inf padding to the budget.
+        count = min(k - 1, max(1, k // 2))
+        ids = torch.stack([torch.randperm(vocab)[:count] for _ in range(n)]).to(torch.int32)
+        logp = torch.full((n, k), -math.inf)
+        for r in range(n):
+            logp[r, :count] = row[r].gather(-1, ids[r].long())
+        ids_rows.append(ids)
+        logp_rows.append(logp)
+        complete.append(torch.ones(n, dtype=torch.bool))
+    ids_rows = [torch.cat([i, torch.full((n, k - i.shape[1]), HEAD_PADDING_ID, dtype=torch.int32)], 1) if i.shape[1] < k else i for i, n in zip(ids_rows, lengths, strict=True)]
+    data = TensorDict(
+        {
+            "rollout_topk_ids": torch.nested.as_nested_tensor(ids_rows, layout=torch.jagged),
+            "rollout_topk_log_probs": torch.nested.as_nested_tensor(logp_rows, layout=torch.jagged),
+            "rollout_support_complete": torch.nested.as_nested_tensor(complete, layout=torch.jagged),
+        },
+        batch_size=[len(lengths)],
+    )
+    return data
+
+
+def _compact(data, lengths):
+    """Convert full-sequence dense heads into PSRL's full-sequence compact triple."""
+    ids = data["rollout_topk_ids"].values()
+    logp = data["rollout_topk_log_probs"].values()
+    finite = logp.isfinite()
+    counts = finite.sum(-1).to(torch.int32)
+    flat_ids = ids[finite].to(torch.int32)
+    flat_logp = logp[finite].to(torch.float32)
+    receipt = (
+        _flatten_receipt(data["rollout_support_complete"])
+        if "rollout_support_complete" in data.keys()
+        else torch.zeros(ids.shape[0], dtype=torch.bool)
+    )
+    return TensorDict(
+        {
+            "rollout_topk_lengths": counts,
+            "rollout_support_ids": flat_ids,
+            "rollout_support_log_probs": flat_logp,
+            "rollout_support_complete": receipt,
+        },
+        batch_size=[],
+    )
+
+
+def _flatten_receipt(receipt):
+    if isinstance(receipt, torch.Tensor) and receipt.is_nested:
+        return receipt.values()
+    return torch.as_tensor(receipt)
+
+
+def test_compact_topk_matches_dense():
+    lengths, k, vocab = [3, 4], 5, 19
+    dense = _dense_topk(lengths, k, vocab)
+    compact = _compact(dense, lengths)
+    logits = torch.randn(1, sum(lengths), vocab, requires_grad=True)
+    dense_out = score_centering_logits_processor(logits, dense, _actor_config(_topk_config()))
+    compact_out = score_centering_logits_processor(logits, compact, _actor_config(_topk_config()))
+    for key in dense_out:
+        torch.testing.assert_close(compact_out[key], dense_out[key], atol=1e-6, rtol=1e-6)
+
+
+def test_compact_support_matches_dense():
+    lengths, k, vocab = [3, 4], 6, 19
+    dense = _dense_support(lengths, k, vocab)
+    compact = _compact(dense, lengths)
+    logits = torch.randn(1, sum(lengths), vocab, requires_grad=True)
+    dense_out = score_centering_logits_processor(logits, dense, _actor_config(_support_config()))
+    compact_out = score_centering_logits_processor(logits, compact, _actor_config(_support_config()))
+    for key in dense_out:
+        torch.testing.assert_close(compact_out[key], dense_out[key], atol=1e-6, rtol=1e-6)
+
+
+def test_shared_sampled_token_score_matches_log_softmax():
+    lengths, k, vocab = [3, 4], 4, 17
+    data = _dense_topk(lengths, k, vocab)
+    labels = torch.randint(0, vocab, (sum(lengths),))
+    logits = torch.randn(1, sum(lengths), vocab, requires_grad=True)
+    out = score_centering_logits_processor(
+        logits,
+        data,
+        _actor_config(_topk_config()),
+        sampled_token_ids=labels,
+    )
+    ref = torch.log_softmax(logits[0].float(), dim=-1).gather(-1, labels.unsqueeze(-1)).squeeze(-1)
+    torch.testing.assert_close(out["log_probs"].squeeze(0), ref, atol=1e-5, rtol=1e-5)
+
+
+def test_tail_ratio_is_one_on_verified_support_rows():
+    lengths, k, vocab = [3, 4], 6, 19
+    data = _dense_support(lengths, k, vocab)
+    logits = torch.randn(1, sum(lengths), vocab)
+    out = score_centering_logits_processor(logits, data, _actor_config(_support_config()))
+    torch.testing.assert_close(out["sc_tail_ratio"], torch.ones_like(out["sc_tail_ratio"]))
