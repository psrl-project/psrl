diff --git a/vllm/entrypoints/grpc_server.py b/vllm/entrypoints/grpc_server.py
index 5bb8ea1b4..a765d5c0b 100644
--- a/vllm/entrypoints/grpc_server.py
+++ b/vllm/entrypoints/grpc_server.py
@@ -21,6 +21,7 @@ Example:
 import argparse
 import asyncio
 import signal
+import os
 import sys
 import time
 
@@ -28,6 +29,7 @@ try:
     import grpc
     from grpc_reflection.v1alpha import reflection
     from smg_grpc_proto import vllm_engine_pb2, vllm_engine_pb2_grpc
+    from smg_grpc_servicer.vllm.preemption import PreemptionStatLogger
     from smg_grpc_servicer.vllm.servicer import VllmEngineServicer
 except ImportError:
     raise ImportError(
@@ -52,6 +54,11 @@ async def serve_grpc(args: argparse.Namespace):
     """
     Main gRPC serving function.
 
+    Creates a gRPC server with:
+    - HTTP/2 keepalive configuration to prevent "too many pings" errors
+    - Preemption event streaming support via PreemptionStatLogger
+    - VllmEngineServicer handling Generate, Abort, and SubscribePreemptionEvents RPCs
+
     Args:
         args: Parsed command line arguments
     """
@@ -68,27 +75,65 @@ async def serve_grpc(args: argparse.Namespace):
         usage_context=UsageContext.OPENAI_API_SERVER,
     )
 
-    # Create AsyncLLM
+    # Create a preemption queue for bridging scheduler stats to gRPC stream.
+    # This queue receives preempted request IDs from PreemptionStatLogger
+    # (which is registered as a stat logger) and feeds them to
+    # SubscribePreemptionEvents for client streaming.
+    preemption_queue: asyncio.Queue[list[str]] = asyncio.Queue()
+
+    # Create PreemptionStatLogger as a stat logger factory.
+    # This captures threshold-crossed preemptions and enqueues them to the queue.
+    # The factory will be instantiated for each engine instance during AsyncLLM init.
+    def preemption_stat_logger_factory(vllm_config, engine_index=0):
+        return PreemptionStatLogger(
+            vllm_config,
+            engine_index=engine_index,
+            preemption_queue=preemption_queue,
+        )
+
+    # Create AsyncLLM with preemption stat logger registered.
     async_llm = AsyncLLM.from_vllm_config(
         vllm_config=vllm_config,
         usage_context=UsageContext.OPENAI_API_SERVER,
         enable_log_requests=args.enable_log_requests,
         disable_log_stats=args.disable_log_stats,
+        stat_loggers=[preemption_stat_logger_factory],
     )
 
-    # Create servicer
-    servicer = VllmEngineServicer(async_llm, start_time)
+    # Create servicer with preemption queue
+    servicer = VllmEngineServicer(async_llm, start_time, preemption_queue=preemption_queue)
+    logger.info("VllmEngineServicer initialized with preemption event streaming support")
+
+    # Get ping interval from environment or use default.
+    # The HTTP/2 protocol defaults to 300s, which is too strict for idle connections.
+    # A value of 5000ms (5s) provides a good balance:
+    #   - Tolerates client-side keepalive pings sent frequently (every few seconds)
+    #   - Detects dead connections within ~10-20 seconds (2-4 missed pings)
+    # Can be overridden via VLLM_GRPC_MIN_RECV_PING_INTERVAL_MS environment variable.
+    min_recv_ping_interval_ms = int(
+        os.environ.get("VLLM_GRPC_MIN_RECV_PING_INTERVAL_MS", "5000")
+    )
+    logger.info(
+        "gRPC server configured with min_recv_ping_interval_without_data_ms=%d",
+        min_recv_ping_interval_ms,
+    )
 
-    # Create gRPC server
+    # Create gRPC server with HTTP/2 keepalive options
     server = grpc.aio.server(
         options=[
             ("grpc.max_send_message_length", -1),
             ("grpc.max_receive_message_length", -1),
-            # Tolerate client keepalive pings every 10s (default 300s is too
-            # strict for non-streaming requests where no DATA frames flow
-            # during generation)
-            ("grpc.http2.min_recv_ping_interval_without_data_ms", 10000),
+            # Tolerate client keepalive pings at the configured interval
+            # to avoid "Too many pings" errors during idle periods in
+            # streaming requests (e.g., preemption notifications)
+            ("grpc.http2.min_recv_ping_interval_without_data_ms", min_recv_ping_interval_ms),
+            # Allow keepalive pings even when no calls are active.
+            # This is essential for streaming RPCs that may not send DATA frames
+            # for extended periods (e.g., SubscribePreemptionEvents waiting for events)
             ("grpc.keepalive_permit_without_calls", True),
+            # Disable GOAWAY on ping-rate violations. The default max_ping_strikes=2
+            # causes premature connection kills during connect-time PING bursts.
+            ("grpc.http2.max_ping_strikes", 0),
         ],
     )
 
