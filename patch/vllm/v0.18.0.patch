+# ---------------------------------------------------------------------------
+# WeightLayoutSpec and SupportsWeightLayoutSpec
+# ---------------------------------------------------------------------------
+from dataclasses import dataclass
+
+
+@dataclass
+class WeightLayoutSpec:
+    """Describes how a vLLM model's packed parameters map to HF weight components.
+
+    stacked_params:
+        Each entry: (packed_param_suffix, hf_component_suffix, shard_id).
+        shard_id is "q"/"k"/"v" for QKV; int 0/1 for gate_up_proj.
+    packing_metadata:
+        Model config values (num_heads, num_kv_heads, head_size, intermediate_size,
+        num_experts, moe_intermediate_size) needed to compute split sizes.
+        All values come from self.config — no new data is introduced.
+    expert_params:
+        For MoE models: output of get_expert_mapping(). Format per entry:
+        (packed_param_suffix, hf_weight_suffix, expert_id, shard_id)
+        where shard_id is "w1" (gate), "w2" (down), or "w3" (up).
+        None for non-MoE models.
+    extra_stacked_params:
+        For models with full layer-qualified paths (e.g., Arctic).
+        Each entry: (full_packed_path, full_hf_path, shard_id).
+        None for standard models.
+    """
+
+    stacked_params: list[tuple[str, str, "str | int"]]
+    packing_metadata: dict[str, Any]
+    expert_params: "list[tuple[str, str, int, str]] | None" = None
+    extra_stacked_params: "list[tuple[str, str, str | int]] | None" = None
+
+
+@runtime_checkable
+class SupportsWeightLayoutSpec(Protocol):
+    """Interface for vLLM models that expose their weight packing structure.
+
+    All ForCausalLM / ForConditionalGeneration top-level model classes should
+    implement this interface. load_weights() should call get_weight_layout_spec()
+    instead of re-declaring stacked_params_mapping as a local variable.
+    """
+
+    supports_weight_layout_spec = True  # type: ClassVar[Literal[True]]
+
+    def get_weight_layout_spec(self) -> "WeightLayoutSpec":
+        """Return the weight layout specification for this model.
+
+        The returned spec must be consistent with stacked_params_mapping used
+        inside load_weights(). Changing one must change the other.
+        """
+        ...
+
+    @classmethod
+    def __subclasshook__(cls, C: type) -> bool:
+        if cls is SupportsWeightLayoutSpec:
+            return hasattr(C, "get_weight_layout_spec")
+        return NotImplemented  # type: ignore[return-value]
+
+
 @runtime_checkable
 class SupportsLoRA(Protocol):
     """The interface required for all models that support LoRA."""
